{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where this file’s JSON Schema lives.",
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "open-playing-cards"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "deckId": {
      "type": "string",
      "description": "Stable id of the deck, unchanged across exports and edits."
    },
    "contentHash": {
      "description": "SHA-256 of this file with $schema, createdAt, generator and contentHash removed. Equal hashes mean the same deck.",
      "type": "string"
    },
    "deckType": {
      "description": "Set when the deck is exactly a standard French pack (plus optional jokers).",
      "type": "string",
      "const": "french-52"
    },
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "description": "How this deck may be used, ideally an SPDX id such as \"CC-BY-4.0\".",
      "type": "string"
    },
    "source": {
      "description": "Where the deck came from, for attribution.",
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "What wrote the file. Informational only."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "When the file was written."
    },
    "card": {
      "type": "object",
      "properties": {
        "widthMm": {
          "type": "number",
          "description": "Trim width of the finished card."
        },
        "heightMm": {
          "type": "number"
        },
        "cornerRadiusMm": {
          "type": "number"
        },
        "bleedMm": {
          "description": "Extra image beyond the trim size on every side, for printing. Absent or 0 means the image is trimmed to size.",
          "type": "number"
        },
        "imageWidth": {
          "description": "Pixel width of every PNG in the file, bleed included. Absent when the deck ships vector cards only.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dpi": {
          "description": "Resolution the PNGs were rendered at. Absent when the deck ships vector cards only.",
          "type": "number"
        }
      },
      "required": [
        "widthMm",
        "heightMm",
        "cornerRadiusMm"
      ]
    },
    "suits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$",
            "description": "Colour as lower-case #rrggbb, or #rrggbbaa when it has transparency."
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "symbol",
          "color",
          "order"
        ]
      }
    },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "indexHeightMm": {
            "type": "number",
            "description": "Drawn height of this rank’s corner index. Compare with card.heightMm to judge whether it survives the size you draw at."
          }
        },
        "required": [
          "id",
          "label",
          "value",
          "indexHeightMm"
        ]
      }
    },
    "back": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^(data:image\\/png;base64,[A-Za-z0-9+/=]+|(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w.-]+(?:\\/[\\w.-]+)*\\.png)$",
          "description": "PNG image: a base64 data: URI, or a path relative to this file (no leading \"/\" and no \"..\" segment)."
        },
        "vector": {
          "type": "string",
          "pattern": "^(data:image\\/svg\\+xml;base64,[A-Za-z0-9+/=]+|data:image\\/svg\\+xml,[^\"']+|(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w.-]+(?:\\/[\\w.-]+)*\\.svg)$",
          "description": "SVG image: a data: URI, base64 or percent-encoded, or a path relative to this file (no leading \"/\" and no \"..\" segment)."
        }
      },
      "anyOf": [
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "vector"
          ]
        }
      ]
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id, \"<suit>-<rank>\" for standard cards, e.g. \"hearts-K\"."
          },
          "kind": {
            "type": "string",
            "enum": [
              "standard",
              "joker"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Position in play order, so a shuffled or filtered hand can be sorted back."
          },
          "suit": {
            "description": "Suit id, or null for jokers.",
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "description": "Rank id, or null for jokers.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "Default ordinal for the rank, A = 1 to K = 13; null for jokers. Not a game rule.",
            "type": [
              "number",
              "null"
            ]
          },
          "label": {
            "type": "string",
            "description": "Short label, e.g. \"K♥\"."
          },
          "name": {
            "type": "string",
            "description": "Readable name, e.g. \"King of Hearts\"."
          },
          "color": {
            "type": "string",
            "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$",
            "description": "Main ink colour of the card."
          },
          "image": {
            "description": "The card face at card.imageWidth × card.imageHeight, with transparent rounded corners.",
            "type": "string",
            "pattern": "^(data:image\\/png;base64,[A-Za-z0-9+/=]+|(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w.-]+(?:\\/[\\w.-]+)*\\.png)$"
          },
          "vector": {
            "description": "The same face as vector art, text outlined, sharp at any size. Prefer it when drawing small.",
            "type": "string",
            "pattern": "^(data:image\\/svg\\+xml;base64,[A-Za-z0-9+/=]+|data:image\\/svg\\+xml,[^\"']+|(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w.-]+(?:\\/[\\w.-]+)*\\.svg)$"
          }
        },
        "required": [
          "id",
          "kind",
          "order",
          "suit",
          "rank",
          "value",
          "label",
          "name",
          "color"
        ],
        "anyOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "vector"
            ]
          }
        ]
      },
      "description": "Every card in play order: suit by suit, ranks ascending, jokers last."
    }
  },
  "required": [
    "format",
    "version",
    "deckId",
    "name",
    "generator",
    "createdAt",
    "card",
    "suits",
    "ranks",
    "back",
    "cards"
  ]
}
