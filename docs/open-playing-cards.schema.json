{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "open-playing-cards"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "What wrote the file. Informational only."
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 timestamp."
    },
    "card": {
      "type": "object",
      "properties": {
        "widthMm": {
          "type": "number"
        },
        "heightMm": {
          "type": "number"
        },
        "cornerRadiusMm": {
          "type": "number"
        },
        "imageWidth": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Pixel width of every image in the file."
        },
        "imageHeight": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "dpi": {
          "type": "number"
        }
      },
      "required": [
        "widthMm",
        "heightMm",
        "cornerRadiusMm",
        "imageWidth",
        "imageHeight",
        "dpi"
      ]
    },
    "suits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$",
            "description": "Colour as lower-case #rrggbb, or #rrggbbaa when it has transparency."
          }
        },
        "required": [
          "id",
          "name",
          "symbol",
          "color"
        ]
      }
    },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "label",
          "value"
        ]
      }
    },
    "back": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^data:image\\/png;base64,.*",
          "description": "PNG image as a base64 data URI."
        }
      },
      "required": [
        "image"
      ]
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id, \"<suit>-<rank>\" for standard cards, e.g. \"hearts-K\"."
          },
          "kind": {
            "type": "string",
            "enum": [
              "standard",
              "joker"
            ]
          },
          "suit": {
            "description": "Suit id, or null for jokers.",
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "description": "Rank id, or null for jokers.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "Numeric rank, A = 1 to K = 13; null for jokers.",
            "type": [
              "number",
              "null"
            ]
          },
          "label": {
            "type": "string",
            "description": "Short label, e.g. \"K♥\"."
          },
          "name": {
            "type": "string",
            "description": "Readable name, e.g. \"King of Hearts\"."
          },
          "color": {
            "type": "string",
            "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$",
            "description": "Main ink colour of the card."
          },
          "image": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^data:image\\/png;base64,.*",
            "description": "The card face at card.imageWidth × card.imageHeight, with transparent rounded corners."
          }
        },
        "required": [
          "id",
          "kind",
          "suit",
          "rank",
          "value",
          "label",
          "name",
          "color",
          "image"
        ]
      },
      "description": "Every card in play order: suit by suit, ranks ascending, jokers last."
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "author",
    "description",
    "generator",
    "createdAt",
    "card",
    "suits",
    "ranks",
    "back",
    "cards"
  ]
}
