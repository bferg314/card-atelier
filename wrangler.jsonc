{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "card-atelier",
  "compatibility_date": "2026-09-22",
  // A static site: Workers serves the built files, with no Worker script of its own.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "card-atelier.tinyibex.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
